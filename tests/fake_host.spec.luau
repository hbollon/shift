--!nonstrict
local t = require("./lib/testing.luau")
local FakeHost = require("./lib/fake_host.luau")

t.describe("FakeHost", function()
  t.describe("clock", function()
    t.it("starts at the given time and advances", function()
      local host = FakeHost.new({ nowMs = 1000 })
      host.clock.advance(500)
      t.expect(host.nowMs()).toBe(1500)
      host.clock.set(42)
      t.expect(host.nowMs()).toBe(42)
    end)
  end)

  t.describe("state", function()
    t.it("delivers every set to watchers, including identical values", function()
      local host = FakeHost.new()
      local seen = {}
      host.state.watch("k", function(v)
        table.insert(seen, v)
      end)
      host.state.set("k", "x")
      host.state.set("k", "x")
      t.expect(seen).toEqual({ "x", "x" })
      t.expect(host.state.get("k")).toBe("x")
    end)
  end)

  t.describe("filesystem", function()
    t.it("writes, renames, lists and removes files", function()
      local host = FakeHost.new()
      host.writeFile("/data/a.tmp", "1")
      t.expect(host.renameFile("/data/a.tmp", "/data/ledger/2026.json")).toBe(true)
      t.expect(host.readFile("/data/ledger/2026.json")).toBe("1")
      t.expect(host.fileExists("/data/ledger")).toBe(true)
      t.expect(host.listDir("/data")).toEqual({ "ledger" })
      host.removeFile("/data/ledger/2026.json")
      local contents, err = host.readFile("/data/ledger/2026.json")
      t.expect(contents).toBeNil()
      t.expect(err).toBeTruthy()
    end)
  end)

  t.describe("tr", function()
    t.it("substitutes placeholders and falls back to the key", function()
      local host = FakeHost.new({ translations = { ["a.b"] = "Hello {name}" } })
      t.expect(host.tr("a.b", { name = "Hugo" })).toBe("Hello Hugo")
      t.expect(host.tr("missing.key")).toBe("missing.key")
    end)
  end)
end)

t.finish()
